# TrackSense AI - backend environment
#
# EVERY VARIABLE HERE IS OPTIONAL. The app starts and runs correctly with no
# .env file at all. There are no API keys, no accounts and no paid services.
#
# To use it anyway: copy this file to `.env` in the same folder and edit.
#     cp .env.example .env

# Which origins the browser is allowed to call the API from.
# The Vite dev server is http://localhost:5173. Add your Vercel URL here when
# you deploy the frontend, comma separated. "*" allows anything.
# TRACKSENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the SQLite file lives. Default: backend/data/tracksense.db
# TRACKSENSE_DB_PATH=./data/tracksense.db

# Where uploads and sample frames live. Default: backend/data
# TRACKSENSE_DATA_DIR=./data

# Which folder the /demo endpoint reads its frames from.
# Default: backend/data/samples (the bundled synthetic set).
# Note: if backend/data/samples_real/ contains 4 or more images, that folder is
# used automatically and you do not need to set this at all.
# TRACKSENSE_SAMPLES_DIR=./data/samples

# Log verbosity: DEBUG, INFO, WARNING, ERROR. Default INFO.
# TRACKSENSE_LOG_LEVEL=INFO

# Where Hugging Face caches the CLIP weights (~600 MB).
# Default is ~/.cache/huggingface. Set this only if that drive is full.
# HF_HOME=./.hf-cache

# Set to 1 to force offline mode - transformers will refuse to hit the network
# and will only use already-downloaded weights. Useful if campus wifi is slow
# and you know the model is already cached.
# HF_HUB_OFFLINE=1
